OPENAI_API_KEY=sk-...
# Fastest: Claude Haiku 5.5 without thinking (~1 s per Tuttie round) for Tuttie and the hotel agents.
# OpenAI works too: LLM_MODEL=gpt-5.1 + LLM_REASONING_EFFORT=none (~1.2 s), or gpt-6-luna with thinking (~2-3 s).
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-5-5
LLM_REASONING_EFFORT=low
LLM_REASONING_SUMMARY=
AGENT_LLM_MODEL=claude-haiku-5-5
# Only needed if port 4000 is taken on your machine.
REGISTRY_PORT=4000
GUEST_NAME=Alex Muster
# The owner view (/owner/) signs in with this token; without it the nodes refuse the owner view.
# Whoever has it can read the private negotiation limits and change prices, so keep it secret.
OWNER_TOKEN=choose-a-long-random-string

# Voice (optional): ElevenLabs for speech, a self-hosted LiveKit server for real-time audio.
ELEVENLABS_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_NODE_IP=  # the server's public IP, for media over ports 4042 (TCP) and 4043 (UDP)
# Voice relay for phones (TURN on TCP 4044, voice/turnserver.conf; coturn unpacked into
# ~/.local/coturn, or set TURNSERVER). Any random string; without it voice works only where UDP
# gets through.
TURN_SECRET=
