# systemd user service that keeps the whole demo running (registry, nodes, assistant).
# Install:  cp deploy/tuttie.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#           systemctl --user enable --now tuttie
# Deploy new code: systemctl --user restart tuttie     Logs: journalctl --user -u tuttie -f
[Unit]
Description=Tuttie agent web demo
After=network-online.target

[Service]
WorkingDirectory=%h/project-repo/code
ExecStart=%h/project-repo/code/run.sh
Restart=always
RestartSec=3
KillSignal=SIGINT
# Open SSE streams keep uvicorn from shutting down; do not wait for them.
TimeoutStopSec=10

[Install]
WantedBy=default.target
